# ---- Database ----
POSTGRES_USER=photoevent
POSTGRES_PASSWORD=photoevent
POSTGRES_DB=photoevent
# For local (non-docker) runs use localhost; docker-compose overrides host to "db".
DATABASE_URL=postgresql+psycopg://photoevent:photoevent@localhost:5432/photoevent

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
# Provide EITHER a plaintext password (hashed on startup) OR a precomputed bcrypt hash.
ADMIN_PASSWORD=changeme
# ADMIN_PASSWORD_HASH=

# ---- Google Drive storage ----
# Auth mode: "oauth" uploads as a real user (uses their personal Drive quota) —
# required for consumer @gmail.com accounts. "service_account" needs a Shared Drive.
DRIVE_AUTH_MODE=oauth
# OAuth client secrets (Desktop app type) from Google Cloud Console > Credentials.
GOOGLE_OAUTH_CLIENT_SECRETS=/app/oauth-client-secrets.json
# Token file generated by scripts/generate_oauth_token.py (holds the refresh token).
GOOGLE_OAUTH_TOKEN_PATH=/app/oauth-token.json
# Service-account key (only used when DRIVE_AUTH_MODE=service_account).
GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json
# ID of the parent Drive folder under which all event folders are created.
# Find it in the folder's URL: drive.google.com/drive/folders/<THIS_ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id

# ---- Face recognition ----
# Engine: "insightface" (512-d) or "face_recognition" (128-d).
FACE_ENGINE=insightface
FACE_EMBEDDING_DIM=512
# Cosine-distance threshold for a match (lower = stricter). 0.0 = identical.
FACE_MATCH_THRESHOLD=0.45
FACE_SEARCH_TOP_K=200

# ---- App ----
FRONTEND_ORIGIN=http://localhost:3000

# ---- Thumbnails (local WebP cache) ----
THUMBNAIL_DIR=/app/data/thumbnails
THUMBNAIL_MAX_EDGE=600
THUMBNAIL_WEBP_QUALITY=75

# ---- Bulk ZIP upload ----
ZIP_TMP_DIR=/app/data/tmp
ZIP_MAX_WORKERS=4
